__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# 发布产物构建目录(wheel/sdist/绿色便携包,由会话内构建、上传 Release,不进版本库)
dist_release/
portable_build/
.pytest_cache/
.venv/
venv/
# 本地生成的作业目录
job*/
/scratch/
# 离线演示自带的合成"已完成"作业集必须入库(上面的 job*/ 规则会误伤 jobs/)
!examples/offline_analysis/jobs/
# 离线演示产物(examples/offline_analysis/run_demo.py 默认输出)
demo_out/

# 本地临时/QA 工作区；正式研究结果使用 results/，发布产物使用 dist/
/tmp/

# results/ 建议输出目录:忽略生成内容,保留目录占位
/results/*
!/results/.gitkeep

# PyInstaller 旧残留(build/ dist/ 上面已忽略)
_internal/

# 用户本地敏感/机器相关配置(绝不入 git)
clusters.yaml
known_hosts
/config.local.yaml

# 本地实配(含真实赝势库路径/内网 LLM 端点等,绝不入 git;复制 config.example.yaml 生成)
config.yaml
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/

# GUI/测试运行时临时产物（不得进入功能分支）
pytest-of-root/
vcstudio_paste/
vcs_solv_*_POSCAR
vcstudio_deps_*.log
qa_outputs/
