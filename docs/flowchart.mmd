flowchart TD
  U(["用户 · 点击操作<br/>无需记 Linux/调度器命令"]):::user

  subgraph G["① 生成 Generate · vcstudio/generate"]
    direction TB
    G1["POSCAR + 用户 INCAR<br/>计算类型 slab/bulk/molecule"] --> G2["校验并补全四件套<br/>INCAR · KPOINTS 倒格矢 · POTCAR · POSCAR<br/>缺项才补, 绝不改用户键"]
    G2 --> G3["写 job.yaml 清单<br/>sha256 溯源 · 赝势身份"]
  end

  subgraph S["② 提交 Submit · vcstudio/cluster"]
    direction TB
    S1["PBS / Slurm 方言 + preflight 闸"] --> S2["生成作业脚本"]
    S2 --> S3["SSH 上传 + qsub/sbatch → 记作业号"]
  end

  subgraph M["③ 监控 + 诊断 Monitor · vcstudio/cluster"]
    direction TB
    M1{"查 qstat/squeue<br/>作业号在队列里?"}
    M1 -->|"排队"| MQ["QUEUED"]:::q
    M1 -->|"运行"| MR["RUNNING + SCF 活体检查"]:::run
    M1 -->|"不在 = GONE"| GATE{"续算沉降护栏<br/>本轮真的产出了吗?"}
    GATE -->|"续算后新作业未启动<br/>OUTCAR 未刷新"| MQ2["保持 SUBMITTED<br/>疑仍在排队, 不误判"]:::q
    GATE -->|"确有本轮产出"| MG["取证 OUTCAR/OSZICAR/日志/退出码"]
    MG --> MD["diagnose.classify<br/>12+ 失败类"]
  end

  MD --> DONE{"结果?"}
  DONE -->|"收敛+能量合理"| OK["DONE"]:::ok
  DONE -->|"未收敛/墙钟/ZBRENT"| REC
  DONE -->|"硬崩/缺输出/磁盘满"| HUM["NEEDS_HUMAN 交人工"]:::fail

  subgraph REC["④ 有界恢复 Recovery · vcstudio/cluster"]
    direction TB
    R2["CONTCAR 续算 / 白名单改参续算<br/>≤ 3 轮 · INCAR 冻结"]
  end
  R2 -.重投.-> S3

  subgraph A["⑤ 分析 + 报告 Analyze · vcstudio/project + external"]
    direction TB
    A1["ΔE 门控 · 一组作业全 DONE 才出数"] --> A2["吸附能 ΔE / ΔG 台阶 / d带中心 / Bader"]
    A2 --> A3["原生论文级出图 · 报告 · 可选 LLM 分析"]
  end

  U --> G --> S --> M
  MQ --> M1
  MR --> M1
  MQ2 --> M1
  OK --> A

  classDef user fill:#dbeafe,stroke:#2563eb,color:#0b2545;
  classDef q fill:#fef3c7,stroke:#d97706,color:#78350f;
  classDef run fill:#d1fae5,stroke:#059669,color:#064e3b;
  classDef ok fill:#bbf7d0,stroke:#16a34a,color:#14532d;
  classDef fail fill:#fee2e2,stroke:#dc2626,color:#7f1d1d;
